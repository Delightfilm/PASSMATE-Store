# Public browser-safe values only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_QUESTION_BANK_CONTENT_URL=https://content.mypassmate.com

# Local/dev build escape hatch only. Production should remain false/unset.
PASSMATE_ALLOW_LOCAL_CATALOG_FALLBACK=false

# Server-only secrets must never be committed.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Private NAS AI explanation cache; both are server-only. No API key in the browser.
PASSMATE_AI_CACHE_URL=https://content.mypassmate.com/ai-cache
PASSMATE_AI_CACHE_TOKEN=
# On Vercel, AI Gateway uses automatic OIDC. For local tests only:
# AI_GATEWAY_API_KEY=
