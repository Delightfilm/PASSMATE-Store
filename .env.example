# Public browser-safe values only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local/dev build escape hatch only. Production should remain false/unset.
PASSMATE_ALLOW_LOCAL_CATALOG_FALLBACK=false

# Server-only secrets must never be committed.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
