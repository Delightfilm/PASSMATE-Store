# Public browser-safe values only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local/dev build escape hatch only. Production should remain false/unset.
PASSMATE_ALLOW_LOCAL_CATALOG_FALLBACK=false

# Server-only secrets must never be committed.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CBT server exams stay disabled unless explicitly configured and verified.
# DB cbt_private.server_exams.enabled must also be true; absent/false blocks RPCs.
# Only migrations/DB administrators may change that marker (app is SELECT-only).
# Server-only, exact Supabase project refs, comma separated; empty blocks all APIs.
CBT_SERVER_PROJECT_REFS=
# New starts only. Keep allowed ref and server secret when pausing existing exams.
NEXT_PUBLIC_CBT_SERVER_EXAMS=0
