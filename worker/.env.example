# Supabase server-only credentials.
# Never commit the real service role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Safe default. disabled can run --check-config but will not claim jobs.
PASSMATE_PROCESSOR_MODE=disabled
PASSMATE_STORAGE_BUCKET=passmate-artifacts

PASSMATE_WORKER_ID=nas-passmate-01
PASSMATE_POLL_SECONDS=10
PASSMATE_LEASE_SECONDS=300
PASSMATE_HEARTBEAT_SECONDS=60
PASSMATE_REQUEST_TIMEOUT_SECONDS=30

# REFERENCE INTEGRATION TEST ONLY.
# Must remain false in production mode.
PASSMATE_ALLOW_REFERENCE_COPY=false

# docker-compose host paths
PASSMATE_NAS_MASTER_PATH=/PASSMATE/01_MASTER
PASSMATE_NAS_WORK_PATH=/PASSMATE/00_SYSTEM/temp
PASSMATE_NAS_OUTPUT_PATH=/PASSMATE/02_ISSUED
