# Existing public configuration verified against the live NAS SHA-256:
# c6a5edce05ea1233ae97dbf157795014ff0b3dbe80d2213d07a6d287ef76b19d
# Add only the authenticated AI cache path; source releases remain read-only.
server {
  listen 8080;
  server_name _;
  root /srv/passmate;
  server_tokens off;
  etag on;
  client_max_body_size 1k;

  include /etc/nginx/security-headers.conf;

  if ($request_method = OPTIONS) {
    return 204;
  }

  location = /health.json {
    include /etc/nginx/security-headers.conf;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }

  location = /catalog.json {
    include /etc/nginx/security-headers.conf;
    default_type application/json;
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    try_files $uri =404;
  }

  location = /excluded-questions.jsonl.gz {
    include /etc/nginx/security-headers.conf;
    default_type application/x-ndjson;
    add_header Content-Encoding gzip always;
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    try_files $uri =404;
  }

  location ~ ^/bundles/[0-9A-Za-z_-]+\.json\.gz$ {
    include /etc/nginx/security-headers.conf;
    default_type application/json;
    add_header Content-Encoding gzip always;
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    try_files $uri =404;
  }

  location ~ "^/images/[a-f0-9]{2}/[a-f0-9]{64}\.[0-9A-Za-z]+$" {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location ^~ /ai-cache/ {
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $ai_cache_origin http://passmate-ai-cache:8090;
    rewrite ^/ai-cache/(.*)$ /$1 break;
    proxy_pass $ai_cache_origin;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    client_max_body_size 32k;
    proxy_request_buffering on;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    limit_except GET POST { deny all; }
  }

  location / {
    return 404;
  }
}
