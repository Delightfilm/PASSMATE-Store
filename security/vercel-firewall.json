{
  "version": "2026-10-17",
  "managed": { "bot-protection": "challenge", "ai-bots": "deny" },
  "rules": [
    {
      "name": "PASSMATE exploit probes",
      "description": "Deny requests for non-existent secret/VCS/PHP scanner targets; preserve real PASSMATE routes.",
      "active": true,
      "conditionGroup": [{ "conditions": [{ "type": "path", "op": "re", "value": "(^|/)(\\.env(?:\\.[^/]+)?|\\.git|wp-admin|wp-login\\.php|xmlrpc\\.php|phpmyadmin)(/|$)" }] }],
      "action": { "mitigate": { "action": "deny" } }
    },
    {
      "name": "PASSMATE CBT API burst",
      "description": "Temporary per-IP CBT API limit; excludes static assets, auth callbacks and payment webhooks.",
      "active": true,
      "conditionGroup": [{ "conditions": [{ "type": "path", "op": "pre", "value": "/api/cbt/" }] }],
      "action": { "mitigate": { "action": "rate_limit", "rateLimit": { "algo": "fixed_window", "window": 60, "limit": 600, "keys": ["ip"], "action": "rate_limit" } } }
    },
    {
      "name": "PASSMATE verified SE Ranking audit",
      "description": "Official SE Ranking IPs + SEBot-WA on public GET/HEAD SEO paths only. Preserve DDoS, exploit and API protections.",
      "active": true,
      "conditionGroup": [{ "conditions": [
        { "type": "path", "op": "re", "value": "^/(?:$|cbt(?:/|$)|robots\\.txt$|sitemap\\.(?:xml|txt)$|terms/?$|privacy/?$|cbtmate-logo\\.png$|favicon\\.ico$|_next/static/)" },
        { "type": "user_agent", "op": "eq", "value": "SEBot-WA" },
        { "type": "ip_address", "op": "inc", "value": [
          "5.9.48.208", "23.88.36.149", "37.27.13.192", "37.27.22.37", "37.27.22.127", "37.27.29.8",
          "46.4.81.149", "62.238.32.219", "116.202.175.208", "136.243.103.47", "138.201.137.152",
          "142.132.195.214", "144.76.14.242", "144.76.15.151", "144.76.69.81", "144.76.164.62",
          "144.76.237.123", "162.55.94.175", "162.55.94.176", "162.55.244.19", "167.233.95.57",
          "167.233.145.180", "167.233.148.147", "167.233.156.129", "168.119.64.236", "176.9.41.54",
          "176.9.64.179", "176.9.74.49", "178.63.105.151"
        ] },
        { "type": "method", "op": "inc", "value": ["GET", "HEAD"] },
        { "type": "host", "op": "eq", "value": "www.mypassmate.com" }
      ] }],
      "action": { "mitigate": { "action": "bypass" } }
    }
  ]
}
