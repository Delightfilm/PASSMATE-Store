{
  "name": "passmate-store",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check && next build",
    "start": "next start",
    "check:catalog": "node scripts/validate-catalog.mjs",
    "check:orders": "node scripts/validate-order-state.mjs",
    "check:jobs": "node scripts/validate-issuance-job-contract.mjs",
    "check:auth": "node scripts/validate-auth-config.mjs",
    "check": "npm run check:catalog && npm run check:orders && npm run check:jobs && npm run check:auth && npm run check:payments && npm run check:checkout && npm run check:downloads",
    "check:payments": "node scripts/validate-payment-contract.mjs",
    "check:checkout": "node scripts/validate-checkout-shell.mjs",
    "check:downloads": "node scripts/validate-download-contract.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "22.x"
  }
}
